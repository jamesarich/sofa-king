# Editor defaults for every file; the Kotlin style is kotlin.code.style=official in each build's gradle.properties.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.{yml,yaml,json,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.swift]
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
