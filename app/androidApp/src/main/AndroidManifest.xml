<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 asks for it before the app reaches the server, or finds it, on the local network. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Settings > About installs a newer snapshot when the viewer asks; the system confirms the first install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets Android 14 and later skip that confirmation for an app that installed itself, as Android 12 and 13 do. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- The Android TV home screen's Watch Next row, which follows the library's Continue watching shelf. -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <!-- A restart drops the home screen's grant to read the row's artwork; the app grants it again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Music plays on behind the app through a media playback service (MusicService) and its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Lets the app see whether a speech recognizer is installed before it offers voice search, and which home screen
         apps read the Watch Next row's artwork. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".SofaKingApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/banner"
        android:description="@string/app_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.SofaKing">

        <!-- Google TV's pointer remotes, and a mouse on any TV: a hovered control takes focus and a click presses it. -->
        <meta-data android:name="android.software.leanback.supports_touch" android:value="true" />

        <!-- One activity, in its own task, so the launcher or a link brings back the player in picture-in-picture (as
             onNewIntent) rather than opening a second one inside the small window. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.SofaKing.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The admin portal's pairing QR code: a phone's camera hands sofaking://pair?server=...&code=... to the app. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sofaking" android:host="pair" />
            </intent-filter>
            <!-- A Watch Next entry on the home screen plays its item, sofaking://vod/ID?t=SECONDS, and a home automation's
                 am start a channel, sofaking://live/NUMBER. Not BROWSABLE, so web pages cannot. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sofaking" android:host="vod" />
                <data android:scheme="sofaking" android:host="live" />
            </intent-filter>
        </activity>

        <!-- The Watch Next row's artwork, read by the home screen through a URI grant. -->
        <provider
            android:name=".WatchNextArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".ArtworkGrantReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Holds the music's media session while a song plays, so it plays on behind the app. Exported, as Media3
             asks, so the system's media controls (the notification, Assistant, a Bluetooth headset) can bind to it;
             the session itself decides which controllers it accepts. -->
        <service
            android:name="dev.jamesrich.sofaking.ui.player.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
