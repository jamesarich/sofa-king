{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "enabledManagers": ["gradle", "gradle-wrapper", "dockerfile", "docker-compose", "github-actions"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "description": "AGENTS.md: track Kotlin EAP builds",
      "matchDatasources": ["maven", "gradle-plugin"],
      "matchPackageNames": ["org.jetbrains.kotlin:*", "org.jetbrains.kotlin.*"],
      "ignoreUnstable": false,
      "respectLatest": false
    },
    {
      "description": "AGENTS.md: track kotlinx.serialization and kotlinx.coroutines prereleases",
      "matchDatasources": ["maven"],
      "matchPackageNames": ["org.jetbrains.kotlinx:kotlinx-serialization-*", "org.jetbrains.kotlinx:kotlinx-coroutines-*"],
      "ignoreUnstable": false,
      "respectLatest": false
    },
    {
      "description": "The wrapper is pinned to a Gradle milestone; keep following prereleases",
      "matchManagers": ["gradle-wrapper"],
      "ignoreUnstable": false
    },
    {
      "description": "Built locally from the Dockerfile; not in any registry",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["sofa-king-backend"],
      "enabled": false
    }
  ]
}
