# Copy to deploy/.env and replace the tokens. The server refuses to start on the LAN bind
# until SOFA_API_TOKEN has at least 32 characters. Generate each one:  openssl rand -hex 32
SOFA_API_TOKEN=CHANGE_ME

# Token for the lineup admin API (/api/v1/admin/*), at least 32 characters. Leave it out and the
# API token administers the lineup too.
SOFA_ADMIN_TOKEN=CHANGE_ME_TOO

# Token third-party players (TiviMate, VLC) put in the M3U, XMLTV and stream URLs under /output/*, at least
# 32 letters, digits, hyphens or underscores (openssl rand -hex 16). Leave it out to keep those routes closed
# to anything but the API token as a bearer.
SOFA_OUTPUT_TOKEN=CHANGE_ME_FOR_PLAYERS

# Days of guide the XMLTV output carries (1-14).
SOFA_XMLTV_DAYS=3

# The secret path of the masqueradarr playlist; deploy/sources.json refers to it as ${MASQ_PLAYLIST_PATH}.
MASQ_PLAYLIST_PATH=CHANGE_ME_SECRET_PATH

# LAN restream proxies whose 502 is evidence against the offering, host[:port], comma separated.
SOFA_RESTREAM_ORIGINS=192.168.1.3:3000

# Concurrent source probes (1-32) and active playback sessions (1-16).
SOFA_PROBE_PARALLELISM=6
SOFA_MAX_SESSIONS=4
