# Optional. Copy to deploy/.env to change a setting; the server starts without it. Every variable is described in
# docs/live-tv.md#server-settings.

# The user and group the container runs as: the owner of ./config. Defaults to 1000:1000; use `id -u` and `id -g`.
# UID=1000
# GID=1000

# The container's time zone. The server keeps and serves its times in UTC either way.
TZ=Etc/UTC

# Tokens. Left unset, the API and admin tokens are generated at the first start and kept in config/secrets.json;
# read them with: docker compose exec sofa-king-backend cat /config/secrets.json. Set one here, or name a file holding it with the _FILE
# variant (Docker secrets), to choose it yourself: at least 32 characters, from openssl rand -hex 32. Set a token
# or its _FILE variant, not both.
# SOFA_API_TOKEN_FILE=/run/secrets/sofa_api_token
# SOFA_ADMIN_TOKEN_FILE=/run/secrets/sofa_admin_token

# Token that player URLs carry under /output/*, at least 32 letters, digits, hyphens or underscores
# (openssl rand -hex 16). Leave it out and only the API token, as a bearer, opens those routes.
# SOFA_OUTPUT_TOKEN=CHANGE_ME_OUTPUT
# SOFA_OUTPUT_TOKEN_FILE=/run/secrets/sofa_output_token

# Days of guide the XMLTV output carries (1-14).
SOFA_XMLTV_DAYS=3

# HDHomeRun emulation for Plex Live TV, served without a token at the root of each port. compose.yaml turns it
# off unless SOFA_HDHR_ENABLED=true is set here. Name the Plex server's address (IPs or CIDR blocks, comma
# separated) in SOFA_HDHR_ALLOW. Tuners are concurrent Plex streams, at most SOFA_MAX_SESSIONS.
# SOFA_HDHR_ENABLED=true
# SOFA_HDHR_ALLOW=PLEX_SERVER_IP
# SOFA_HDHR_TUNERS=2
# SOFA_HDHR_NAME=Sofa King

# Extra HDHomeRun devices for a large lineup, up to seven ports. Publish each one in compose.yaml.
# See docs/live-tv.md#several-devices-for-a-large-lineup.
# SOFA_HDHR_EXTRA_PORTS=8081,8082
# Host ports Plex reaches each device on, in device order. compose.yaml publishes port 8080 as 9193.
# SOFA_HDHR_PUBLIC_PORTS=9193,8081,8082

# Keep Plex Live TV's channel maps in step with the lineup. The token is the Plex server's X-Plex-Token
# (PlexOnlineToken in its Preferences.xml); it is a secret. See docs/live-tv.md#keep-plex-in-step.
# SOFA_PLEX_URL=http://host.docker.internal:32400
# SOFA_PLEX_TOKEN=CHANGE_ME_PLEX_TOKEN
# SOFA_PLEX_TOKEN_FILE=/run/secrets/sofa_plex_token
# SOFA_PLEX_SYNC_MINUTES=60
# Where Plex reaches this server's tuners, without a port; set it to let a sync add devices Plex lacks.
# SOFA_PLEX_TUNER_BASE=http://SERVER_HOST

# LAN restream proxies whose 502 counts as evidence against a source, host[:port], comma separated.
# SOFA_RESTREAM_ORIGINS=RESTREAM_HOST:3000

# Concurrent source probes (1-32) and active playback sessions (1-16).
SOFA_PROBE_PARALLELISM=6
SOFA_MAX_SESSIONS=4

# Every ${NAME} that config/sources.json references is read from here, for example a tokenized playlist path.
