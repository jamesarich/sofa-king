# Copy to deploy/.env and replace each CHANGE_ME value. Generate a token with: openssl rand -hex 32
# The server refuses a LAN bind until SOFA_API_TOKEN has at least 32 characters.
SOFA_API_TOKEN=CHANGE_ME

# Token for the lineup admin API (/api/v1/admin/*), at least 32 characters. Leave it out and the
# API token administers the lineup too.
SOFA_ADMIN_TOKEN=CHANGE_ME_ADMIN

# Token that player URLs carry under /output/*, at least 32 letters, digits, hyphens or underscores
# (openssl rand -hex 16). Leave it out and only the API token, as a bearer, opens those routes.
SOFA_OUTPUT_TOKEN=CHANGE_ME_OUTPUT

# Days of guide the XMLTV output carries (1-14).
SOFA_XMLTV_DAYS=3

# HDHomeRun emulation for Plex Live TV, served without a token at the root of each port. Name the Plex
# server's address (IPs or CIDR blocks, comma separated), or every address that reaches the port can watch.
# Set SOFA_HDHR_ENABLED=false when Plex is not used. Tuners are concurrent Plex streams, at most SOFA_MAX_SESSIONS.
SOFA_HDHR_ENABLED=true
SOFA_HDHR_ALLOW=CHANGE_ME_PLEX_SERVER_IP
SOFA_HDHR_TUNERS=2
SOFA_HDHR_NAME=Sofa King

# Extra HDHomeRun devices for a large lineup, up to seven ports. Publish each one in compose.yaml.
# See docs/live-tv.md#several-devices-for-a-large-lineup.
# SOFA_HDHR_EXTRA_PORTS=8081,8082
# Host ports Plex reaches each device on, in device order, when compose.yaml publishes them under other numbers.
# SOFA_HDHR_PUBLIC_PORTS=8080,8081,8082

# Keep Plex Live TV's channel maps in step with the lineup. The token is the Plex server's X-Plex-Token
# (PlexOnlineToken in its Preferences.xml); it is a secret. See docs/live-tv.md#keep-plex-in-step.
# SOFA_PLEX_URL=http://host.docker.internal:32400
# SOFA_PLEX_TOKEN=CHANGE_ME_PLEX_TOKEN
# SOFA_PLEX_SYNC_MINUTES=60
# Where Plex reaches this server's tuners, without a port; set it to let a sync add devices Plex lacks.
# SOFA_PLEX_TUNER_BASE=http://SERVER_HOST

# LAN restream proxies whose 502 counts as evidence against a source, host[:port], comma separated.
# SOFA_RESTREAM_ORIGINS=RESTREAM_HOST:3000

# Concurrent source probes (1-32) and active playback sessions (1-16).
SOFA_PROBE_PARALLELISM=6
SOFA_MAX_SESSIONS=4

# Every ${NAME} that deploy/sources.json references is read from here, for example a tokenized playlist path.
