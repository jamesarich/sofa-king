{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "gradle",
    "gradle-wrapper",
    "dockerfile",
    "docker-compose",
    "github-actions"
  ],
  "packageRules": [
    {
      "description": "The lockfiles workflow rewrites the Gradle lockfiles and verification metadata on macOS; Renovate's own run cannot resolve the app's builds",
      "matchManagers": [
        "gradle"
      ],
      "skipArtifactsUpdate": true
    },
    {
      "description": "Conventional Commits scope: workflow changes are ci",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci"
    },
    {
      "description": "The 0.6.x-compat builds are a compatibility artifact, not newer releases",
      "matchPackageNames": [
        "org.jetbrains.kotlinx:kotlinx-datetime"
      ],
      "allowedVersions": "!/-compat$/"
    },
    {
      "description": "CI pins JDK 21, the toolchain every build compiles with, and Ubuntu 24.04, whose FFmpeg 6.1 matches the server image",
      "matchDepNames": [
        "java-jdk",
        "ubuntu"
      ],
      "enabled": false
    },
    {
      "description": "Kotlin, the Android Gradle plugin and Compose Multiplatform are preview pins that move together",
      "matchDatasources": [
        "maven",
        "gradle-plugin"
      ],
      "matchPackageNames": [
        "org.jetbrains.kotlin:*",
        "org.jetbrains.kotlin.*",
        "com.android.*",
        "com.android.tools.build:*",
        "org.jetbrains.compose",
        "org.jetbrains.compose.*"
      ],
      "groupName": "Kotlin, AGP and Compose Multiplatform"
    },
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "AGENTS.md: track Kotlin EAP builds",
      "matchDatasources": [
        "maven",
        "gradle-plugin"
      ],
      "matchPackageNames": [
        "org.jetbrains.kotlin:*",
        "org.jetbrains.kotlin.*"
      ],
      "ignoreUnstable": false,
      "respectLatest": false
    },
    {
      "description": "AGENTS.md: track kotlinx.serialization and kotlinx.coroutines prereleases",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "org.jetbrains.kotlinx:kotlinx-serialization-*",
        "org.jetbrains.kotlinx:kotlinx-coroutines-*"
      ],
      "ignoreUnstable": false,
      "respectLatest": false
    },
    {
      "description": "The wrapper is pinned to a Gradle milestone; keep following prereleases",
      "matchManagers": [
        "gradle-wrapper"
      ],
      "ignoreUnstable": false
    },
    {
      "description": "Built locally from the Dockerfile; not in any registry",
      "matchManagers": [
        "docker-compose"
      ],
      "matchPackageNames": [
        "sofa-king-backend"
      ],
      "enabled": false
    }
  ],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "semanticCommitType": "build",
  "prHourlyLimit": 0
}
